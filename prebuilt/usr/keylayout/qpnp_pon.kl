#
# pp2106-keypad (aka device 0 - built-in keyboard)
#
#This file is key layout for LGE built-in f3q keyboards. 
# Notes:
#

# Power doubles as the red key: short press hangs up (PhoneWindowManager
# calls TelecomManager.endCall()), long press opens the power menu. Outside
# a call a short press goes home (end_button_behavior=1, as on stock).
key 116	ENDCALL				WAKE

