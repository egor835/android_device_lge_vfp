# LG D486 (vfp) specific init

# This file is imported after mount_all, so early-init/init triggers never fire here
on post-fs
    # Keep msm8226-common's shim and add ours for the stock (KK) camera HAL
    export LD_SHIM_LIBS /system/vendor/lib/libmmqjpeg_codec.so|libboringssl-compat.so:/system/lib/hw/camera.vendor.msm8226.so|libshim_camera.so

on boot
    # LP5521 RGB notification LED
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/led_current_index
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/led_pattern
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/led_blink
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/leds/R/brightness
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/leds/G/brightness
    chown system system /sys/devices/f9925000.i2c/i2c-2/2-0032/leds/B/brightness

    # Keypad backlight
    chown system system /sys/devices/leds-qpnp-e252fe00/leds/button-backlight/brightness

    # PP2106 keypad
    chown system system /sys/devices/platform/pp2106-keypad.0/newhw

service qcamerasvr /system/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics
    writepid /dev/cpuset/system-background/tasks
